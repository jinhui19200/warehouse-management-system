{
  "name": "warehouse-manager",
  "version": "1.6.0",
  "description": "库存管理系统 —— 仓库、记录、出入库操作",
  "main": "./out/main/index.js",
  "author": "lin",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify:store": "esbuild scripts/verify-store.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --outfile=out/verify-store.mjs --log-level=warning && node out/verify-store.mjs",
    "verify:electron": "esbuild scripts/verify-electron.ts --bundle --platform=node --format=cjs --external:electron --alias:@shared=./src/shared --outfile=out/verify-electron.cjs --log-level=warning && electron out/verify-electron.cjs",
    "verify:ui": "npm run build && node scripts/verify-ui.mjs",
    "verify:app": "npm run build && node scripts/verify-app.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "build": "electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.63.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
